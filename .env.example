# Copy this file to .env (or export these as real environment variables)
# and fill in real values. Never commit an actual .env file.

# --- Database (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_dashboard
DB_USERNAME=dashboard_user
DB_PASSWORD=changeme

# --- Auth ---------------------------------------------------------------
# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-key-change-me-before-deploying-anywhere-real
JWT_EXPIRATION_MINUTES=480

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Demo data --------------------------------------------------------
# Seeds an admin account, teachers, classes, subjects, students, results
# and attendance on first run if the database is empty. Set to false for
# a real deployment.
SEED_DEMO_DATA=true

# --- Risk thresholds --------------------------------------------------
# A student is flagged once attendance or average score falls below
# these. Both/either -> HIGH/MEDIUM risk; neither -> LOW.
RISK_ATTENDANCE_THRESHOLD=75.0
RISK_SCORE_THRESHOLD=50.0

# --- Server ---------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
